# Public browser configuration only. NEVER put a Supabase service_role secret here.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GOOGLE_SIGN_IN=false


# Server-only AI assistant (optional). Do NOT prefix with NEXT_PUBLIC_.
# Set GEMINI_API_KEY in the Vercel project Environment Variables for Preview,
# and redeploy. Never paste the key into a chat or commit it to GitHub.
# Without the key, the UII assistant continues to provide curated guidance.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
